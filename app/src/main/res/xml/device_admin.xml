<?xml version="1.0" encoding="utf-8"?>
<!-- Device-admin policies. "disable-camera" lets the app actually cut the
     camera for the whole device on the user's command (no root); "force-lock"
     is the least-intrusive extra capability. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <disable-camera />
        <force-lock />
    </uses-policies>
</device-admin>
